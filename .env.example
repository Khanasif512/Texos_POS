DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/texonpos"
APP_URL="http://localhost:3000"
JWT_ACCESS_SECRET="generate-a-long-random-string"
JWT_REFRESH_SECRET="generate-another-long-random-string"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# TODO: set SIGNUP_OTP_REQUIRED="true" once the SMTP credentials above are ready and before going to actual production.
# "false" (default) skips the signup email OTP: anyone can create an account without proving they own the email.
SIGNUP_OTP_REQUIRED="false"
MAIL_FROM="TexonPOS <no-reply@example.com>"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"
# Shared secret for POST /api/v1/admin/jobs/run (header x-cron-secret) — subscription lifecycle job
CRON_SECRET="generate-a-long-random-string"
